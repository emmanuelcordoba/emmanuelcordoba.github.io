---
import { links, nav, profile } from "../data/cv";
import SocialIcon from "./SocialIcon.astro";
---

<header
  class="bg-brand text-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-40 lg:flex lg:w-72 lg:flex-col lg:justify-center lg:px-10"
>
  <div
    class="mx-auto flex max-w-3xl items-center gap-5 px-6 py-6 lg:mx-0 lg:block lg:max-w-none lg:px-0 lg:py-0"
  >
    <img
      src="/profile.jpg"
      alt={profile.name}
      width="480"
      height="480"
      class="h-16 w-16 shrink-0 rounded-full object-cover ring-3 ring-white/25 lg:mx-auto lg:h-36 lg:w-36 lg:ring-4"
    />

    <div class="min-w-0 lg:mt-7 lg:text-center">
      <p class="font-display text-lg leading-tight font-bold lg:text-2xl">
        {profile.name}
      </p>
      <p class="mt-0.5 text-sm text-white/70 lg:mt-2">{profile.role}</p>
      <p class="hidden font-mono text-xs text-white/55 lg:mt-1 lg:block">
        {profile.stack}
      </p>
    </div>
  </div>

  <nav class="hidden lg:mt-10 lg:block">
    <ul class="space-y-1 text-center">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-3 py-1.5 text-sm font-medium text-white/70 transition-colors hover:bg-white/10 hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="hidden lg:mt-10 lg:flex lg:justify-center lg:gap-3">
    <SocialIcon href={links.linkedin} label="LinkedIn" name="linkedin" />
    <SocialIcon href={links.github} label="GitHub" name="github" />
    <SocialIcon href={`mailto:${profile.email}`} label="Email" name="mail" />
  </div>
</header>

{/* Navegación horizontal en mobile: se desplaza en lugar de apilarse. */}
<nav
  class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur-md lg:hidden"
>
  <ul class="flex gap-1 overflow-x-auto px-4 py-2 text-sm whitespace-nowrap">
    {
      nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="inline-block rounded-md px-3 py-1.5 font-medium text-ink-soft transition-colors hover:bg-brand-soft hover:text-brand"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
